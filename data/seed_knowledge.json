	  "responses": ["Hello! How can I help?", "Hi! What's new?", "Hey! How are you?", "Good to see you!"]
	},
	{
	  "tag": "farewell_ar",
	  "patterns": ["وداعا", "باي", "الى اللقاء", "مع السلامة", "تصبح على خير", "يلا نشوفك", "سلام", "في امان الله"],
